// Cloudflare Worker: 旅行時期の質問に、実際の観察データ(creatures.json)だけを根拠に答える
// 環境変数(Secrets): GEMINI_API_KEY, ALLOWED_ORIGIN(例: https://nature-experience-amami.github.io)

const MODEL = "gemini-3.5-flash"; // モデル名は変更される可能性があるので、時々公式ドキュメントで確認してください

// サイトの言語ごとの設定。フロント側(index.html / en,es,zh/index.html)が送ってくる
// lang(ja/en/es/zh)に応じて、参照するcreatures.json・Geminiへの指示言語・
// エラーメッセージをすべて切り替える。langが未指定/未知の値の場合は日本語扱い。
const LANG_CONFIG = {
  ja: {
    name: "Japanese",
    creaturesUrl: "https://nature-experience-amami.github.io/data/creatures.json",
    tooLong: "質問を200文字以内で入力してください。",
    fallback: "うまく答えられませんでした。もう一度試してください。",
  },
  en: {
    name: "English",
    creaturesUrl: "https://nature-experience-amami.github.io/data/creatures.en.json",
    tooLong: "Please keep your question under 200 characters.",
    fallback: "Sorry, I couldn't come up with a good answer. Please try again.",
  },
  es: {
    name: "Spanish",
    creaturesUrl: "https://nature-experience-amami.github.io/data/creatures.es.json",
    tooLong: "Por favor, escribe tu pregunta en menos de 200 caracteres.",
    fallback: "No he podido dar una buena respuesta. Inténtalo de nuevo.",
  },
  zh: {
    name: "Simplified Chinese",
    creaturesUrl: "https://nature-experience-amami.github.io/data/creatures.zh.json",
    tooLong: "请将问题控制在200字以内。",
    fallback: "抱歉，未能给出合适的回答，请再试一次。",
  },
};

export default {
  async fetch(request, env) {
    const cors = {
      "Access-Control-Allow-Origin": env.ALLOWED_ORIGIN,
      "Access-Control-Allow-Methods": "POST, OPTIONS",
      "Access-Control-Allow-Headers": "Content-Type",
    };

    if (request.method === "OPTIONS") return new Response(null, { headers: cors });
    if (request.method !== "POST") return new Response("Method Not Allowed", { status: 405, headers: cors });

    const { message, lang } = await request.json();
    const config = LANG_CONFIG[lang] || LANG_CONFIG.ja;

    if (!message || message.length > 200) {
      return json({ reply: config.tooLong, creature_ids: [] }, cors);
    }

    const creatures = await (await fetch(config.creaturesUrl)).json();

    // Geminiには「回答文」と「該当する生き物のID」だけをJSONで返させる。
    // 写真パスそのものは作らせない(捏造防止)。パスは必ずcreatures.jsonから実データを引く。
    const prompt = `You are a night-tour guide on Amami Oshima, Japan.
Answer the customer's question using ONLY the [Creature data] below as your source.
Base your answer only on each creature's description, months, name, and category_name fields.
Never invent information that isn't in the data; if the data doesn't cover the question, say so (in ${config.name}) rather than guessing.
Do not infer a "best season to see it" from photo dates — use only the months field for observation timing.
In your answer, use each creature's name and category_name exactly as given in the data (they are already the display names for this language).
The internal id and category fields are for backend use only — never show them in your answer.
creature_ids should list the internal id(s) of any matching creatures (e.g. "akamata").

You must write the "reply" text itself in ${config.name}, regardless of what language the question was asked in.

Output ONLY the following JSON format, with no extra explanation or code block markers:
{"reply": "a natural-sounding answer in ${config.name}, about 2-3 sentences", "creature_ids": ["matching ids only, or an empty array if none"]}

[Creature data]
${JSON.stringify(creatures)}

[Customer's question]
${message}`;

    const res = await fetch(
      `https://generativelanguage.googleapis.com/v1beta/models/${MODEL}:generateContent`,
      {
        method: "POST",
        headers: { "Content-Type": "application/json", "x-goog-api-key": env.GEMINI_API_KEY },
        body: JSON.stringify({ contents: [{ parts: [{ text: prompt }] }] }),
      }
    );
    const data = await res.json();
    const rawText = data?.candidates?.[0]?.content?.parts?.[0]?.text ?? "";

    const parsed = safeParse(rawText, creatures, config);
    return json(parsed, cors);
  },
};

// Geminiがコードブロック(```json ... ```)を付けてしまった場合も剥がしてから解析する。
// 解析に失敗した場合は、生成文をそのままreplyとして返し、creature_idsは空にする(壊れない設計)。
function safeParse(rawText, creatures, config) {
  const cleaned = rawText.replace(/```json|```/g, "").trim();
  try {
    const obj = JSON.parse(cleaned);
    const validIds = new Set(creatures.map((c) => c.id));
    const ids = Array.isArray(obj.creature_ids)
      ? [...new Set(obj.creature_ids.filter((id) => validIds.has(id)))]
      : [];
    return { reply: obj.reply ?? config.fallback, creature_ids: ids };
  } catch {
    return { reply: rawText || config.fallback, creature_ids: [] };
  }
}

function json(body, cors) {
  return new Response(JSON.stringify(body), {
    headers: { "Content-Type": "application/json", ...cors },
  });
}
