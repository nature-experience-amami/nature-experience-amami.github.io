// Cloudflare Worker: 旅行時期の質問に、実際の観察データ(creatures.json)だけを根拠に答える
// 環境変数(Secrets): GEMINI_API_KEY, ALLOWED_ORIGIN(例: https://tetsu5686.github.io)

const CREATURES_URL = "https://tetsu5686.github.io/nature-experience-amami/data/creatures.json";
const MODEL = "gemini-3.5-flash"; // モデル名は変更される可能性があるので、時々公式ドキュメントで確認してください

export default {
  async fetch(request, env) {
    const cors = {
      "Access-Control-Allow-Origin": env.ALLOWED_ORIGIN,
      "Access-Control-Allow-Methods": "POST, OPTIONS",
      "Access-Control-Allow-Headers": "Content-Type",
    };

    if (request.method === "OPTIONS") return new Response(null, { headers: cors });
    if (request.method !== "POST") return new Response("Method Not Allowed", { status: 405, headers: cors });

    const { message } = await request.json();
    if (!message || message.length > 200) {
      return json({ reply: "質問を200文字以内で入力してください。", creature_ids: [] }, cors);
    }

    const creatures = await (await fetch(CREATURES_URL)).json();

    // Geminiには「回答文」と「該当する生き物のID」だけをJSONで返させる。
    // 写真パスそのものは作らせない(捏造防止)。パスは必ずcreatures.jsonから実データを引く。
    const prompt = `あなたは奄美大島のナイトツアーガイドです。
以下の[生き物データ]だけを根拠に、お客さんの質問に答えてください。
データに無い情報は絶対に作らないでください。
回答文では生き物のnameとcategory_nameを使い、必ず自然な日本語の表示名にしてください。
idとcategoryは内部処理用のローマ字なので、回答文には絶対に表示しないでください。
creature_idsには該当する生き物の内部idを返してください（例: "akamata"）。

出力は必ず次のJSON形式のみで、説明文やコードブロックは付けないでください。
{"reply": "日本語で100〜150字程度の回答文", "creature_ids": ["該当するidのみ。無ければ空配列"]}

[生き物データ]
${JSON.stringify(creatures)}

[お客さんの質問]
${message}`;

    const res = await fetch(
      `https://generativelanguage.googleapis.com/v1beta/models/${MODEL}:generateContent`,
      {
        method: "POST",
        headers: { "Content-Type": "application/json", "x-goog-api-key": env.GEMINI_API_KEY },
        body: JSON.stringify({ contents: [{ parts: [{ text: prompt }] }] }),
      }
    );
    const data = await res.json();
    const rawText = data?.candidates?.[0]?.content?.parts?.[0]?.text ?? "";

    const parsed = safeParse(rawText, creatures);
    return json(parsed, cors);
  },
};

// Geminiがコードブロック(```json ... ```)を付けてしまった場合も剥がしてから解析する。
// 解析に失敗した場合は、生成文をそのままreplyとして返し、creature_idsは空にする(壊れない設計)。
function safeParse(rawText, creatures) {
  const cleaned = rawText.replace(/```json|```/g, "").trim();
  try {
    const obj = JSON.parse(cleaned);
    const validIds = new Set(creatures.map((c) => c.id));
    const ids = Array.isArray(obj.creature_ids) ? obj.creature_ids.filter((id) => validIds.has(id)) : [];
    return { reply: obj.reply ?? "うまく答えられませんでした。もう一度試してください。", creature_ids: ids };
  } catch {
    return { reply: rawText || "うまく答えられませんでした。もう一度試してください。", creature_ids: [] };
  }
}

function json(body, cors) {
  return new Response(JSON.stringify(body), {
    headers: { "Content-Type": "application/json", ...cors },
  });
}
